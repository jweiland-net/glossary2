plugin.tx_glossary2 {
  view {
    templateRootPaths {
      0 = EXT:glossary2/Resources/Private/Templates/
      1 = {$glossary2.templateRootPath ?? $plugin.tx_glossary2.view.templateRootPath}
    }
    partialRootPaths {
      0 = EXT:glossary2/Resources/Private/Partials/
      1 = {$glossary2.partialRootPath ?? $plugin.tx_glossary2.view.partialRootPath}
    }
    layoutRootPaths {
      0 = EXT:glossary2/Resources/Private/Layouts/
      1 = {$glossary2.layoutRootPath ?? $plugin.tx_glossary2.view.layoutRootPath}
    }
  }

  persistence {
    storagePid = {$glossary2.storagePid ?? $plugin.tx_glossary2.persistence.storagePid}
  }

  features {
    skipDefaultArguments = 1
  }

  settings {
    pidOfDetailPage = {$glossary2.pidOfDetailPage ?? $plugin.tx_glossary2.settings.pidOfDetailPage}

    list {
      image {
        width = 60c
        height = 60c
      }
    }

    show {
      image {
        width = 200c
        height = 200c
      }
    }

    glossary {
      mergeNumbers = 1
      showAllLink = 1
    }

    pageBrowser {
      class = TYPO3\CMS\Core\Pagination\SimplePagination
      itemsPerPage = {$glossary2.pageBrowser.itemsPerPage ?? $plugin.tx_glossary2.settings.pageBrowser.itemsPerPage}
    }
  }
}
